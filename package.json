{
  "name": "pixel-cascade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A match-3 puzzle where cleared candy shatters into pixels that rain down and briefly assemble into little pixel-art motifs.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
